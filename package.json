{
  "name": "claims-intelligence-engine",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @claims/api\" \"npm run dev -w @claims/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w @claims/api",
    "db:generate": "npm run db:generate -w @claims/api",
    "db:migrate": "npm run db:migrate -w @claims/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "multer": "2.5.0"
  }
}
